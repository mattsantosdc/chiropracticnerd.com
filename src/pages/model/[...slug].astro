---
import { getCollection } from 'astro:content';
import Comments from '../../components/Comments.astro';
import SemanticUseLegend from '../../components/SemanticUseLegend.astro';
import StatementText from '../../components/model/StatementText.astro';
import StatementMaterial from '../../components/model/StatementMaterial.astro';
import ReasoningParticipation from '../../components/model/ReasoningParticipation.astro';
import ReasoningHelp from '../../components/model/ReasoningHelp.astro';
import CriticalQuestions from '../../components/model/CriticalQuestions.astro';
import Layout from '../../layouts/Layout.astro';
import { modelIdentity } from '../../lib/site';
import { getRelatedStatements } from '../../lib/statements.ts';
import { answerHref } from '../../lib/answer-view.ts';
import { buildReasoningIndex } from '../../lib/reasoning.ts';
import { resolveReadingPath } from '../../lib/reading-path.ts';
import { readingHref } from '../../lib/reading-navigation.ts';
import config from '../../data/model-reading-path.json';

export async function getStaticPaths() {
	return (await getCollection('statements')).map((entry) => ({ params: { slug: entry.data.slug }, props: { statementId: entry.data.id } }));
}
const [statements, argumentsList] = await Promise.all([getCollection('statements'), getCollection('arguments')]);
const index = buildReasoningIndex(statements, argumentsList);
const path = resolveReadingPath(config, index);
const statement = index.statementsById.get(Astro.props.statementId)!;
const { entry } = statement;
const uses = entry.data.semanticUses.map((use) => ({ use, statement: index.statementsById.get(use.id)! }));
const usedBy = statements.flatMap((candidate) => candidate.data.semanticUses.filter((use) => use.id === entry.data.id).map((use) => ({ use, statement: index.statementsById.get(candidate.data.id)! })));
const revisionCandidates = index.revisionCandidates(entry.data.id);
const related = getRelatedStatements(statements, entry.data.id);
---
<Layout title={`${entry.data.title} | ${modelIdentity.name}`} description={entry.data.summary}>
	<div class="model-reader statement-detail">
		<p class="eyebrow">{modelIdentity.name} · v{entry.data.version}</p>
		<p><a href={readingHref(path.primaryStatementLocations.get(entry.data.id)!, false)}>Read {entry.data.id} in the Model</a> · <a href={answerHref(statement)}>Examine this answer and its premises</a></p>
		<StatementText statement={statement} heading />
		<section class="entry-summary"><h2 id="entry-summary-title">Summary</h2><p>{entry.data.summary}</p></section>
		<ReasoningParticipation statement={statement} index={index} path={path} integrated={false} />
		<ReasoningHelp />
		<article class="entry-explanation" id="entry-explanation" tabindex="-1" aria-label="Explanation and support">
			<h2>Explanation and support</h2><StatementMaterial statement={statement} />
		</article>
		<CriticalQuestions target={entry.data.id} index={index} />
		<details class="model-disclosure revision-dependencies">
			<summary>Revision relationships</summary>
			<div class="disclosure-body">
				<p>Reasoning links are listed above. The references below identify additional uses of meaning, values or proposed mechanisms.</p>
				{[{ label: 'References used in this statement', entries: uses, empty: 'No additional meaning or mechanism references are recorded here.' }, { label: 'Statements using this reference', entries: usedBy, empty: 'No other statement records an additional use of this reference.' }].map(({ label, entries, empty }) => <section><h3>{label}</h3>{entries.length ? <ul class="dependency-list">{entries.map(({ statement: item, use }) => <li><a href={item.href}>{item.entry.data.id}: {item.entry.data.title}</a><span class="dependency-role">{use.role}</span><span class="dependency-note">{use.note}</span></li>)}</ul> : <p>{empty}</p>}</section>)}
				<section data-revision-candidates={entry.data.id}>
					<h3>Statements to reconsider after a change</h3>
					<p>This list follows the recorded arguments, contrary-claim relationships and additional references. It identifies review candidates; it does not establish that those statements become false or lose every supporting argument.</p>
					{revisionCandidates.length ? <ul>{revisionCandidates.map((item) => <li><a href={item.href}>{item.entry.data.id}: {item.entry.data.title}</a></li>)}</ul> : <p>No other statement is reached through the recorded relationships.</p>}
				</section>
				<SemanticUseLegend />
			</div>
		</details>
		{related.length > 0 && <section><h2>See also</h2><ul>{related.map((item) => <li><a href={index.statementsById.get(item.data.id)!.href}>{item.data.id}: {item.data.title}</a></li>)}</ul></section>}
		<div id="discussion" tabindex="-1"><Comments threadId={entry.data.id} heading="Discuss this statement" intro="What holds up, what doesn’t, and what could make this stronger? Share missing evidence, alternative explanations, or problems with the premises or reasoning." /></div>
	</div>
	<script>import '../../scripts/model-fragments.ts';</script>
</Layout>
