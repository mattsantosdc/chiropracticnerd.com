---
import '../styles/global.css';
import { modelIdentity, siteIdentity } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = siteIdentity.name,
	description = siteIdentity.description,
} = Astro.props;
const pageTitle = title === siteIdentity.name ? title : `${title} | ${siteIdentity.name}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={siteIdentity.author} />
		<meta name="theme-color" content="#0F2D2E" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="shell">
				<a class="brand" href="/" aria-label={`${siteIdentity.name} home`}>
					<img src="/brand/v2/chiropractic-nerd-logo-horizontal.svg" alt={siteIdentity.name} width="590" height="120" />
				</a>
				<nav class="site-nav" aria-label="Primary navigation">
					<a href="/articles/">Articles</a>
					<a href="/model/">{modelIdentity.name}</a>
				</nav>
			</div>
		</header>
		<main class="shell"><slot /></main>
		<footer class="site-footer">
			<div class="shell">
				<a class="footer-brand" href="/" aria-label={`${siteIdentity.name} home`}>
					<img src="/brand/v2/chiropractic-nerd-logo.svg" alt={siteIdentity.name} width="460" height="350" loading="lazy" />
				</a>
				<div>
					<p>{siteIdentity.author} · {siteIdentity.professionalBrand}</p>
					<p>Exploring the philosophy, science, and art of chiropractic.</p>
				</div>
			</div>
		</footer>
	</body>
</html>
