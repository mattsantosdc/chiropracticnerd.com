---
import questionData from '../../data/model-questions.json';
import { validateQuestions } from '../../lib/questions.ts';
import type { ReasoningIndex } from '../../lib/reasoning.ts';
interface Props { target: string; index: ReasoningIndex; namespace?: string }
const { target, index, namespace } = Astro.props;
const headingId = namespace ? `${namespace}--questions-heading` : 'questions-heading';
const questionId = (id: string) => namespace ? `${namespace}--${id.toLowerCase()}` : id.toLowerCase();
const questions = validateQuestions(questionData, new Set(index.statementsById.keys()), new Set(index.argumentsById.keys()))
	.filter((question) => question.target === target);
---
{questions.length > 0 && <section class="critical-questions" aria-labelledby={headingId}>
	<h2 id={headingId}>Questions and alternative explanations</h2>
	<p>These questions help clarify what the account establishes, where it remains open, and what could change it.</p>
	{questions.map((item) => <details class="model-disclosure" id={questionId(item.id)} data-question-id={item.id}>
		<summary>{item.question}</summary>
		<div class="disclosure-body">
			<p>{item.concern}</p>
			<p>{item.response}</p>
			<p><strong>What would change:</strong> {item.wouldChange}</p>
		</div>
	</details>)}
</section>}
