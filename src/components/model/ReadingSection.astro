---
import type { ReasoningIndex } from '../../lib/reasoning.ts';
import type { ResolvedReadingPath, ResolvedReadingSection } from '../../lib/reading-path.ts';
import StatementStep from './StatementStep.astro';
import ArgumentStep from './ArgumentStep.astro';
interface Props { section: ResolvedReadingSection; index: ReasoningIndex; path: ResolvedReadingPath; next?: ResolvedReadingSection; }
const { section, index, path, next } = Astro.props;
---
<section class="reading-section" id={section.anchor} tabindex="-1" data-placement={section.placement}>
	<h2>{section.title}</h2>
	{section.introduction && <p class="section-intro">{section.introduction}</p>}
	{section.steps.map((step) => step.kind === 'statement' ? <StatementStep step={step} /> : <ArgumentStep step={step} index={index} path={path} />)}
	{next && <p class="next-section">Next section in the reading path: <a href={`#${next.anchor}`}>{next.title}</a></p>}
</section>
