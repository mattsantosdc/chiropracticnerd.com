---
import '../styles/global.css';
import { modelIdentity, siteIdentity } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = siteIdentity.name,
	description = siteIdentity.description,
} = Astro.props;
const pageTitle = title === siteIdentity.name ? title : `${title} | ${siteIdentity.name}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={siteIdentity.author} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="shell">
				<a class="brand" href="/">{siteIdentity.name}</a>
				<nav class="site-nav" aria-label="Primary navigation">
					<a href="/articles/">Articles</a>
					<a href="/model/">{modelIdentity.name}</a>
				</nav>
			</div>
		</header>
		<main class="shell"><slot /></main>
		<footer class="site-footer">
			<div class="shell">
				<p>{siteIdentity.author} · {siteIdentity.professionalBrand}</p>
				<p>Exploring the philosophy, science, and art of chiropractic.</p>
			</div>
		</footer>
	</body>
</html>
