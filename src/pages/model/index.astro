---
import { getCollection } from 'astro:content';
import Comments from '../../components/Comments.astro';
import DependencyLegend from '../../components/DependencyLegend.astro';
import ModelAcknowledgment from '../../components/ModelAcknowledgment.astro';
import Layout from '../../layouts/Layout.astro';
import { modelIdentity, siteIdentity } from '../../lib/site';
import { sortArguments, validateArguments } from '../../lib/arguments.ts';
import { domainLabels, domainOrder, sortModelEntries, validateModel } from '../../lib/model';

const [modelEntries, argumentEntries] = await Promise.all([
	getCollection('model'),
	getCollection('arguments'),
]);
const entries = sortModelEntries(modelEntries);
const argumentsList = sortArguments(argumentEntries);
validateModel(entries);
validateArguments(argumentsList, entries);
const groups = domainOrder.map((domain) => ({
	domain,
	entries: entries.filter((entry) => entry.data.domain === domain),
}));
---

<Layout title={modelIdentity.name} description="The Coherent Chiropractic Model by Dr. Matt Santos. Version 0.1 presents its claims, reasoning, and preliminary evidence for examination.">
	<p class="eyebrow">A {siteIdentity.name} project · v0.1</p>
	<h1 class="model-title">{modelIdentity.name}</h1>
	<p class="byline">By {siteIdentity.author}</p>
	<ModelAcknowledgment />
	<p class="lede">
		The Coherent Chiropractic Model connects philosophy, science, and art in a public, revisable account
		of chiropractic. Each entry states a claim, definition, value
		judgment, or strategy that can be examined, challenged, and revised.
	</p>
	<p class="section-intro">
		Every statement included in this version expresses the Model’s current working position.
		Evidence and confidence are assessed separately, and all statements remain open to revision.
	</p>
	<p class="section-intro">
		Version 0.1 presents the Model’s proposed explanations and reasoning for examination.
		Evidence appraisal is preliminary: some claims have limited supporting examples, while others
		await review. Assessment methods, input selection, and criteria for meaningful benefit remain
		to be validated. Each Science entry explains what its cited evidence supports and what remains
		unresolved.
	</p>
	<p class="section-intro">
		Read the highlighted <strong>statements</strong> to see what the Model says. The short titles
		name the entries; open an entry for its summary, explanation, and supporting material.
	</p>
	<div class="meta-row" style="margin-top: 1.25rem">
		<span class="pill">{entries.length} entries</span>
		<span class="pill">{argumentsList.length} arguments</span>
	</div>
	<div class="hero-actions">
		<a class="button secondary" href="/model/arguments/">Inspect the reasoning</a>
	</div>

	{groups.map(({ domain, entries: domainEntries }) => (
		<section>
			<h2>{domainLabels[domain]}</h2>
			<div class="card-grid">
				{domainEntries.map((entry) => (
					<article class="card model-card">
						<a class="card-link" href={`/model/${entry.data.slug}/`}>
							<p class="entry-name"><span>{entry.data.id}</span> · {entry.data.title}</p>
							<div class="entry-statement">
								<p class="statement-label">Statement</p>
								<h3 class="statement-text">{entry.data.claim}</h3>
							</div>
							<span class="entry-read-more">Explanation and support →</span>
						</a>
						<div class="meta-row">
							<span>{entry.data.claimType}</span>
							<span>confidence: {entry.data.confidence}</span>
						</div>
					</article>
				))}
			</div>
		</section>
	))}

	<DependencyLegend />

	<Comments
		threadId="model:general"
		heading="Discuss the Coherent Chiropractic Model"
		intro="Use this for questions and feedback on the Model’s overall structure, scope, assumptions, or approach. If your point applies to one specific entry, join the discussion on that entry instead."
	/>
</Layout>
