---
import ModelProse from '../../../components/model/ModelProse.astro';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { modelIdentity } from '../../../lib/site';
import { sortArguments, validateArguments } from '../../../lib/arguments.ts';
import { sortStatements, validateStatements } from '../../../lib/statements.ts';

const [statementEntries, argumentEntries] = await Promise.all([
	getCollection('statements'),
	getCollection('arguments'),
]);
const entries = sortStatements(statementEntries);
const argumentsList = sortArguments(argumentEntries);
const byStatementId = validateStatements(entries);
validateArguments(argumentsList, entries);
---

<Layout title={`Structured arguments | ${modelIdentity.name}`} description={`The explicit reasoning layer of ${modelIdentity.name}.`}>
	<p class="eyebrow">{modelIdentity.name} v0.1 · Reasoning</p>
	<h1>Structured arguments</h1>
	<p class="lede">
		Each record names a specific inferential route from specified statements to one conclusion.
		Arguments are distinct from revision dependencies, and their validity is evaluated separately
		from the empirical support for their premises.
	</p>
	<p class="section-intro">
		The arguments included in this version form the Model’s current working reasoning.
		Their inclusion does not establish the truth of their empirical premises or settle the
		evaluation of their inferences.
	</p>
	<div class="meta-row" style="margin-top: 1.25rem">
		<span class="pill">{argumentsList.length} arguments</span>
	</div>

	<section>
		<div class="card-grid">
			{argumentsList.map((argument) => {
				const conclusion = byStatementId.get(argument.data.conclusion)!;
				return (
					<article class="card">
						<div class="card-link">
							<div class="meta-row">
								<span>{argument.data.id}</span>
								<span class="pill">{argument.data.inferenceKind}</span>
							</div>
							<h2><a href={`/model/arguments/${argument.data.slug}/`}>{argument.data.title}</a></h2>
							<p><ModelProse>{argument.data.summary}</ModelProse></p>
						</div>
						<div class="argument-links">
							{argument.data.premises.length} premise{argument.data.premises.length === 1 ? '' : 's'}
							{' '}→ <a href={`/model/${conclusion.data.slug}/`}>{conclusion.data.title}</a>
						</div>
					</article>
				);
			})}
		</div>
	</section>

	<p><a href="/model/">← Back to {modelIdentity.shortName}</a></p>
</Layout>
