---
import { getCollection, render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import ModelAcknowledgment from '../../components/ModelAcknowledgment.astro';
import Layout from '../../layouts/Layout.astro';
import { siteIdentity } from '../../lib/site';

export async function getStaticPaths() {
	const articles = await getCollection('articles');

	return articles.map((article) => ({
		params: { slug: article.data.slug },
		props: { contentId: article.id },
	}));
}

const { contentId } = Astro.props;
const articles = await getCollection('articles');
const article = articles.find((candidate) => candidate.id === contentId);

if (!article) throw new Error(`Article not found: ${contentId}`);

const { Content } = await render(article);
---

<Layout title={article.data.title} description={article.data.description}>
	<div class="article-page">
		<article>
			<header class="article-header">
				<p class="eyebrow">{article.data.eyebrow}</p>
				<h1>{article.data.title}</h1>
				{article.data.id === 'article-001' && <ModelAcknowledgment />}
				<p class="byline">By {siteIdentity.author}</p>
				<p class="lede">{article.data.description}</p>
			</header>

			<div class="article-body">
				<Content />
			</div>

			<footer class="article-footer">
				<p>Ready to see how these ideas take shape?</p>
				<a class="button" href="/model/">Explore the Coherent Chiropractic Model →</a>
			</footer>
		</article>

		<Comments
			threadId={`article:${article.data.id}`}
			heading="Discuss this article"
			intro="Question the assumptions, challenge the reasoning, share relevant evidence, or explore the implications. Thoughtful disagreement is welcome."
		/>
	</div>
</Layout>
