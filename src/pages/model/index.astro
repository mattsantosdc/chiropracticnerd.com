---
import { getCollection } from 'astro:content';
import Comments from '../../components/Comments.astro';
import ModelAcknowledgment from '../../components/ModelAcknowledgment.astro';
import ReadingSection from '../../components/model/ReadingSection.astro';
import ReasoningHelp from '../../components/model/ReasoningHelp.astro';
import Layout from '../../layouts/Layout.astro';
import { modelIdentity, siteIdentity } from '../../lib/site';
import { sortArguments } from '../../lib/arguments.ts';
import { domainLabels, domainOrder, sortStatements } from '../../lib/statements';
import readingPathConfig from '../../data/model-reading-path.json';
import { buildReasoningIndex } from '../../lib/reasoning.ts';
import { resolveReadingPath } from '../../lib/reading-path.ts';
import { argumentStep, readingHref } from '../../lib/reading-navigation.ts';

const [statementEntries, argumentEntries] = await Promise.all([getCollection('statements'), getCollection('arguments')]);
const index = buildReasoningIndex(statementEntries, argumentEntries);
const path = resolveReadingPath(readingPathConfig, index);
for (const diagnostic of path.diagnostics) console.warn(diagnostic.message);
const groups = domainOrder.map((domain) => ({ domain, entries: sortStatements(statementEntries).filter((entry) => entry.data.domain === domain) }));
---
<Layout title={modelIdentity.name} description="The Coherent Chiropractic Model by Dr. Matt Santos. Read its statements and follow their reasoning, with support for the premises available to inspect.">
	<div class="model-reader">
		<header class="reading-introduction">
			<p class="eyebrow">A {siteIdentity.name} project · v{path.version}</p>
			<h1 class="model-title">{modelIdentity.name}</h1>
			<p class="byline">By {siteIdentity.author}</p>
			<p class="lede">A revisable account of chiropractic, from living function to practical decisions. Read what the Model proposes, follow its reasoning, and separately examine the support for its premises.</p>
			<ModelAcknowledgment />
		</header>
		<nav class="reading-toc" aria-label="Model sections" id="model-contents">
			<details>
				<summary>On this page · {path.main.length} sections</summary>
				<ol>{path.main.map((section) => <li><a href={`#${section.anchor}`}>{section.title}</a></li>)}</ol>
				<ul class="additional-reading-links">
					{path.orientation && <li><a href={`#${path.orientation.anchor}`}>Optional: {path.orientation.title}</a></li>}
					{path.supporting.map((section) => <li><a href={`#${section.anchor}`}>Supporting: {section.title}</a></li>)}
					<li><a href="#model-reference">Statement and argument index</a></li>
				</ul>
			</details>
		</nav>
		<p class="reading-note">Sections give a reading order. Arguments identify the premises used together.</p>
		<ReasoningHelp />
		<div class="main-reading">{path.main.map((section, i) => <ReadingSection section={section} index={index} path={path} next={path.main[i + 1]} />)}</div>
		{path.orientation && <details class="model-disclosure reading-branch"><summary>Optional orientation: {path.orientation.title}</summary><ReadingSection section={path.orientation} index={index} path={path} /></details>}
		{path.supporting.map((section) => <details class="model-disclosure reading-branch"><summary>Supporting reading: {section.title}</summary><ReadingSection section={section} index={index} path={path} /></details>)}
		<details class="model-disclosure reference-index" id="model-reference">
			<summary>Statement and argument index</summary>
			<div class="disclosure-body">
				{groups.map(({ domain, entries }) => <section><h2>{domainLabels[domain]}</h2><ul>{entries.map((entry) => <li><a href={readingHref(path.primaryStatementLocations.get(entry.data.id)!)}>{entry.data.id}: {entry.data.title}</a> · <a href={index.statementsById.get(entry.data.id)!.href}>Full statement</a></li>)}</ul></section>)}
				<h2>Arguments</h2><ul>{sortArguments(argumentEntries).map((entry) => <li><a href={readingHref(argumentStep(path, entry.data.id).location)}>{entry.data.id}: {entry.data.title}</a> · <a href={index.argumentsById.get(entry.data.id)!.href}>Full argument</a></li>)}</ul>
				<p><a href="/model/arguments/">Browse all argument records</a></p>
			</div>
		</details>
		<div id="discussion" tabindex="-1"><Comments threadId="model:general" heading="Discuss the Coherent Chiropractic Model" intro="Questions and feedback on the Model’s structure, scope, assumptions, or approach are welcome here. Each statement also has its own discussion." /></div>
	</div>
	<script>import '../../scripts/model-fragments.ts';</script>
</Layout>
