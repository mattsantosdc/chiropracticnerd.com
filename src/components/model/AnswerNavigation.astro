---
import type { ReasoningIndex } from '../../lib/reasoning.ts';
import { resolveAnswerQuestions } from '../../lib/answer-view.ts';
import config from '../../data/model-answer-questions.json';
interface Props { index: ReasoningIndex; }
const questions = resolveAnswerQuestions(config, Astro.props.index);
---
<nav class="answer-navigation" id="model-questions" aria-labelledby="answer-navigation-title">
	<h2 id="answer-navigation-title">Start with a question</h2>
	<p>Choose an answer to examine its statement, assumptions and reasoning.</p>
	<ul>{questions.map((question) => <li><a href={question.href}>{question.question}</a></li>)}</ul>
	<p><a href="#model-contents">Follow the complete walkthrough</a></p>
</nav>
