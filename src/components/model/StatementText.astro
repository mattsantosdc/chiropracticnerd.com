---
import type { ResolvedStatement } from '../../lib/reasoning.ts';
import { domainLabels } from '../../lib/statements.ts';
interface Props { statement: ResolvedStatement; anchor?: string; heading?: boolean; role?: string; compact?: boolean; }
const { statement, anchor, heading = false, role = 'statement', compact = false } = Astro.props;
const { data } = statement.entry;
const Text = heading ? 'h1' : 'p';
const typeLabels = { framework: 'Framework commitment', definition: 'Definition', empirical: 'Empirical claim', mixed: 'Mixed claim', value: 'Value judgment', strategy: 'Strategy' };
---
<div class="statement-appearance" id={anchor} tabindex={anchor ? '-1' : undefined} data-statement-id={data.id} data-role={role}>
	<p class="entry-name">{compact ? <>{data.id} · {data.title}</> : <a href={statement.href}>{data.id} · {data.title}</a>}</p>
	<Text class="statement-text">{data.statement}</Text>
	<p class="statement-meta">
		<span>{!compact && 'Type: '}{typeLabels[data.statementType]}</span>
		{(!compact || data.confidence !== 'not-applicable') && <span>Confidence: {data.confidence === 'not-applicable' ? 'Not applicable' : data.confidence}</span>}
		{!compact && <span>{domainLabels[data.domain]}</span>}
	</p>
</div>
