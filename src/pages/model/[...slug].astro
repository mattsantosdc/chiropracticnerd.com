---
import { getCollection, render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import RelationshipLegend from '../../components/RelationshipLegend.astro';
import Layout from '../../layouts/Layout.astro';
import { domainLabels, sortModelEntries, validateModel } from '../../lib/model';

export async function getStaticPaths() {
	const allEntries = sortModelEntries(await getCollection('model'));
	validateModel(allEntries);

	return allEntries.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { contentId: entry.id },
	}));
}

const { contentId } = Astro.props;
const allEntries = sortModelEntries(await getCollection('model'));
const byId = validateModel(allEntries);
const entry = allEntries.find((candidate) => candidate.id === contentId);

if (!entry) throw new Error(`Model entry not found: ${contentId}`);

const { Content } = await render(entry);

const upstream = entry.data.upstream
	.map((relationship) => ({ relationship, entry: byId.get(relationship.id)! }));

const related = allEntries.filter(
	(candidate) =>
		entry.data.related.includes(candidate.data.id) ||
		candidate.data.related.includes(entry.data.id),
);

const downstream = allEntries.flatMap((candidate) =>
	candidate.data.upstream
		.filter((relationship) => relationship.id === entry.data.id)
		.map((relationship) => ({ relationship, entry: candidate }))
);
---

<Layout title={entry.data.title} description={entry.data.summary}>
	<p class="eyebrow">{domainLabels[entry.data.domain]} · {entry.data.id}</p>
	<h1>{entry.data.title}</h1>
	<div class="meta-row">
		<span class={`pill ${entry.data.status}`}>{entry.data.status}</span>
		<span class="pill">{entry.data.claimType}</span>
		<span class="pill">confidence: {entry.data.confidence}</span>
		<span class="pill">v{entry.data.version}</span>
	</div>
	<p class="claim">{entry.data.claim}</p>

	<div class="model-layout">
		<div class="model-main">
			<article class="model-body">
				<Content />

				{entry.data.inference && (
					<section>
						<h2>Explicit inference</h2>
						<p><strong>Rule:</strong> {entry.data.inference.rule}</p>
						<p>{entry.data.inference.explanation}</p>
					</section>
				)}

				{entry.data.whatWouldChange && (
					<section>
						<h2>What would change this entry</h2>
						<p>{entry.data.whatWouldChange}</p>
					</section>
				)}

				{entry.data.references.length > 0 && (
					<section>
						<h2>Sources and anchors</h2>
						<ul class="reference-list">
							{entry.data.references.map((reference) => (
								<li>
									<a href={reference.url}>{reference.title}</a>
									{' '}<span class="pill">{reference.kind}</span>
									{reference.note && <div>{reference.note}</div>}
								</li>
							))}
						</ul>
					</section>
				)}
			</article>

			<Comments
				threadId={`model:${entry.data.id}`}
				heading="Discuss this entry"
				intro="What holds up, what doesn’t, and what could make this stronger? Share missing evidence, alternative explanations, or problems with the premises or reasoning."
			/>
		</div>

		<aside class="side-panel">
			<h2>Depends on</h2>
			{upstream.length ? <ul class="relationship-list">{upstream.map(({ entry: item, relationship }) => <li><a href={`/model/${item.data.slug}/`}>{item.data.id}: {item.data.title}</a><span class="relationship-kind">{relationship.relation}</span>{relationship.note && <span class="relationship-note">{relationship.note}</span>}</li>)}</ul> : <p>Root entry</p>}
			<h2>Used by</h2>
			{downstream.length ? <ul class="relationship-list">{downstream.map(({ entry: item, relationship }) => <li><a href={`/model/${item.data.slug}/`}>{item.data.id}: {item.data.title}</a><span class="relationship-kind">{relationship.relation}</span>{relationship.note && <span class="relationship-note">{relationship.note}</span>}</li>)}</ul> : <p>No downstream entries yet.</p>}
			{related.length > 0 && <><h2>Related</h2><ul>{related.map((item) => <li><a href={`/model/${item.data.slug}/`}>{item.data.id}: {item.data.title}</a></li>)}</ul></>}
			<RelationshipLegend />
			<a href="/model/">← Back to the full map</a>
		</aside>
	</div>
</Layout>
