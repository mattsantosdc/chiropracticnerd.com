{
  "name": "chiropracticnerd.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "audit:model": "node scripts/model-audit.mjs",
    "prebuild": "node scripts/model-audit.mjs --check",
    "build": "astro build",
