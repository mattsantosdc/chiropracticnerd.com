---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Chiropractic Nerd',
	description = 'A public, evolving model of chiropractic from first principles.',
} = Astro.props;
const pageTitle = title === 'Chiropractic Nerd' ? title : `${title} | Chiropractic Nerd`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="shell">
				<a class="brand" href="/">Chiropractic Nerd</a>
				<nav class="site-nav" aria-label="Primary navigation">
					<a href="/model/">The Model</a>
				</nav>
			</div>
		</header>
		<main class="shell"><slot /></main>
		<footer class="site-footer">
			<div class="shell">A public model meant to be examined, challenged, and revised.</div>
		</footer>
	</body>
</html>
