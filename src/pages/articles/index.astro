---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const articles = (await getCollection('articles')).sort((a, b) =>
	a.data.title.localeCompare(b.data.title)
);
---

<Layout title="Articles" description="Articles by Dr. Matt Santos exploring the philosophy, science, and art of chiropractic.">
	<p class="eyebrow">Articles</p>
	<h1>Ideas worth examining.</h1>
	<p class="lede">
		Writing by Dr. Matt Santos on the philosophy, science, and art of chiropractic,
		including the ideas behind the Coherent Chiropractic Model.
	</p>

	<section class="card-grid" aria-label="Articles">
		{articles.map((article) => (
			<article class="card">
				<a class="card-link" href={`/articles/${article.data.slug}/`}>
					<h2>{article.data.title}</h2>
					<p>{article.data.description}</p>
					<span>Read article →</span>
				</a>
			</article>
		))}
	</section>
</Layout>
