    "test:browser": "node tests/model-browser.mjs"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.129.0"
  }
}
