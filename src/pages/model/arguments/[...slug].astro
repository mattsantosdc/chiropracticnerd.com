---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { modelIdentity } from '../../../lib/site';
import { buildReasoningIndex } from '../../../lib/reasoning.ts';
import { resolveReadingPath } from '../../../lib/reading-path.ts';
import { argumentStep, readingHref } from '../../../lib/reading-navigation.ts';
import config from '../../../data/model-reading-path.json';
import ArgumentStep from '../../../components/model/ArgumentStep.astro';
import ReasoningHelp from '../../../components/model/ReasoningHelp.astro';

export async function getStaticPaths() {
	return (await getCollection('arguments')).map((entry) => ({ params: { slug: entry.data.slug }, props: { argumentId: entry.data.id } }));
}
const [statements, argumentsList] = await Promise.all([getCollection('statements'), getCollection('arguments')]);
const index = buildReasoningIndex(statements, argumentsList);
const path = resolveReadingPath(config, index);
const step = argumentStep(path, Astro.props.argumentId);
if (step.kind !== 'argument') throw new Error(`Missing argument ${Astro.props.argumentId}`);
const { data } = step.argument.entry;
---
<Layout title={`${data.title} | ${modelIdentity.name}`} description={data.summary}>
	<div class="model-reader argument-detail">
		<p class="eyebrow">{modelIdentity.name} · Reasoning · v{data.version}</p>
		<h1>{data.title}</h1>
		<p><a href={readingHref(step.location, false)}>Read {data.id} in the Model</a> · <a href="/model/arguments/">All argument records</a></p>
		<ArgumentStep step={step} index={index} path={path} integrated={false} />
		<ReasoningHelp />
	</div>
	<script>import '../../../scripts/model-fragments.ts';</script>
</Layout>
